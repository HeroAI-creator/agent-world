{
    "display_information": {
        "name": "Tessa - Armada Intake",
        "description": "Send Tessa an intake photo - she drafts the documents, emails the firm, and files the claim.",
        "background_color": "#1f1a13"
    },
    "features": {
        "bot_user": {
            "display_name": "Tessa",
            "always_online": true
        }
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "chat:write",
                "files:read",
                "files:write",
                "im:history",
                "channels:history",
                "groups:history",
                "mpim:history"
            ]
        }
    },
    "settings": {
        "event_subscriptions": {
            "bot_events": [
                "message.im",
                "message.channels",
                "message.groups",
                "message.mpim"
            ]
        },
        "interactivity": {
            "is_enabled": false
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "token_rotation_enabled": false
    }
}
